<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>agent молочный зубик</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            color: #d1d5db;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        /* Плавное движение фоновой картинки */
        .bg-image {
            position: absolute;
            top: -10%;
            left: -10%;
            width: 120%;
            height: 120%;
            background-image: url('Кот гот.jfif');
            background-size: cover;
            background-position: center;
            filter: blur(25px);
            z-index: 1;
            opacity: 0.4; 
            animation: pulseBg 15s infinite alternate ease-in-out;
        }

        @keyframes pulseBg {
            0% { transform: scale(1); }
            100% { transform: scale(1.15); }
        }

        /* Анимированный переливающийся градиент на фоне */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(20, 5, 30, 0.85), rgba(5, 20, 35, 0.85), rgba(25, 10, 20, 0.85), rgba(10, 10, 15, 0.85));
            background-size: 400% 400%;
            animation: gradientBG 12s ease infinite;
            z-index: 2;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            position: relative;
            z-index: 3;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 400px;
            padding: 50px 20px;
        }

        /* Парящая аватарка */
        .avatar {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.15);
            margin-bottom: 20px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0% { transform: translateY(0px); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6); }
            50% { transform: translateY(-12px); box-shadow: 0 15px 40px rgba(255, 255, 255, 0.15); }
            100% { transform: translateY(0px); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6); }
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f3f4f6;
            margin-bottom: 6px;
            text-align: center;
            letter-spacing: 0.5px;
        }

        p.subtitle {
            font-size: 14px;
            color: #9ca3af;
            margin-bottom: 35px;
            text-align: center;
            font-weight: 400;
        }

        .links {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Кнопки с бликами */
        .link-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 16px;
            border-radius: 14px;
            text-decoration: none;
            color: #d1d5db;
            font-weight: 500;
            font-size: 16px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
            overflow: hidden; /* Скрываем выходящий за края блик */
        }

        /* Эффект блика */
        .link-btn::before {
            content: '';
            position: absolute;
            top: 0; 
            left: -150%; 
            width: 50%; 
            height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-25deg);
            transition: all 0.6s ease;
        }

        .link-btn:hover::before {
            left: 200%;
        }

        /* Анимация кнопки при наведении */
        .link-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-5px) scale(1.02);
            color: #ffffff;
            box-shadow: 0 12px 25px rgba(255, 255, 255, 0.1);
        }

        /* Анимация иконки */
        .icon {
            position: absolute;
            left: 20px;
            width: 22px;
            height: 22px;
            fill: currentColor;
            opacity: 0.8;
            transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .link-btn:hover .icon {
            opacity: 1;
            transform: scale(1.2) rotate(8deg);
        }
    </style>
</head>
